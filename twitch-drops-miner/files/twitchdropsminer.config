config twitchdropsminer 'main'
	option enabled '1'
	option data_dir '/etc/twitchdropsminer'
	option log_level '2'
	# must name a lang/<name>.json shipped with the package; unknown values fall
	# back to English rather than stopping the miner
	option language 'English'
	option connection_quality '1'
	option priority_mode '0'
	option available_drops_check '0'
	option enable_badges_emotes '0'
	option proxy ''
	# list priority 'Game name'
	# list exclude 'Game name'
