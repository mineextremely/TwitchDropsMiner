#!/bin/sh /etc/rc.common
#
# Init script for the headless Twitch Drops Miner.
# Generates the miner's settings.json from UCI, then runs the miner under procd.
#
USE_PROCD=1
START=95
STOP=10

APP_DIR=/usr/lib/twitchdropsminer

json_add_game() {
	json_add_string "" "$1"
}

generate_settings() {
	local path="$1"
	local proxy="$2"
	local priority_mode="$3"
	local connection_quality="$4"
	local available_drops_check="$5"
	local language="$6"
	local enable_badges_emotes="$7"

	# shellcheck source=/dev/null
	. /usr/share/libubox/jshn.sh

	json_init
	# ordered game priority list
	json_add_array priority
	config_list_foreach main priority json_add_game
	json_close_array
	# excluded games - a typed 'set' wrapper
	json_add_object exclude
	json_add_string __type set
	json_add_array data
	config_list_foreach main exclude json_add_game
	json_close_array
	json_close_object
	# priority mode - a typed enum wrapper (0=priority only, 1=ending soonest, 2=low availability first)
	json_add_object priority_mode
	json_add_string __type PriorityMode
	json_add_int data "$priority_mode"
	json_close_object
	# proxy - a typed URL wrapper
	json_add_object proxy
	json_add_string __type URL
	json_add_string data "$proxy"
	json_close_object
	json_add_int connection_quality "$connection_quality"
	json_add_boolean available_drops_check "$available_drops_check"
	# The miner's own language, naming a lang/<name>.json shipped in the package.
	# An unknown name is not fatal: main.py catches the ValueError and stays English.
	json_add_string language "$language"
	# Without this, badge/emote-only campaigns are never considered eligible.
	json_add_boolean enable_badges_emotes "$enable_badges_emotes"
	json_dump > "$path"
}

start_service() {
	config_load twitchdropsminer
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get data_dir main data_dir "/etc/twitchdropsminer"
	config_get log_level main log_level 2
	config_get connection_quality main connection_quality 1
	config_get priority_mode main priority_mode 0
	config_get_bool available_drops_check main available_drops_check 0
	config_get proxy main proxy ""
	config_get language main language "English"
	config_get_bool enable_badges_emotes main enable_badges_emotes 0

	case "$log_level" in
		0) verbose="";;
		1) verbose="-v";;
		2) verbose="-vv";;
		3) verbose="-vvv";;
		*) verbose="-vvvv";;
	esac

	mkdir -p "$data_dir"
	generate_settings "$data_dir/settings.json" \
		"$proxy" "$priority_mode" "$connection_quality" "$available_drops_check" \
		"$language" "$enable_badges_emotes"
	# keep the miner's log file in RAM - avoids flash wear, and makes it
	# easily readable from LuCI
	ln -sf /tmp/twitchdropsminer.log "$data_dir/log.txt"

	procd_open_instance
	procd_set_param command /usr/bin/python3 "$APP_DIR/main.py" --headless --log $verbose
	procd_set_param env TDM_DATA_DIR="$data_dir" PYTHONPATH="$APP_DIR/deps"
	# restart on crashes, but limit restarts to 5 within an hour
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# drop the runtime state, so LuCI doesn't keep showing stale mining data
	# for a miner that isn't running anymore
	rm -f /tmp/twitchdropsminer.status.json \
		/tmp/twitchdropsminer.inventory.json
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger twitchdropsminer
}
